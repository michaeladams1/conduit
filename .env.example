# Copy this file to .env for local testing.
# On Railway, set these as Variables in the project settings instead —
# you do not upload .env there.

OPENAI_API_KEY=sk-...

# Required after you run build-vector-store.js once (see README):
OPENAI_VECTOR_STORE_ID=vs_...

# Optional overrides (defaults shown):
# REALTIME_MODEL=gpt-realtime
# SMS_MODEL=gpt-4o-mini
# REALTIME_VOICE=alloy
# PORT=3000
